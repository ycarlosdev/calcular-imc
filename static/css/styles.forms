/* =============================================
   ESTILOS PARA FORMULARIOS DE LOGIN Y REGISTRO
   ============================================= */

/* ========== CONTENEDOR PRINCIPAL DEL FORMULARIO ========== */
.form {
    background-color: var(--color-formulario);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    padding: 30px;
    width: 100%;
    max-width: 450px;
    margin: 40px auto;
}

/* ========== CONTENEDORES DE CAMPOS ========== */
.form__contain-name,
.form__contain-email,
.form__contain-password {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

/* ========== ETIQUETAS (LABELS) ========== */
.name_user-label,
.email_user-label,
.password_user-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-texto-principal);
    margin: 0;
}

/* ========== INPUTS ========== */
.name_user-input,
.email_user-input,
.password_user-input {
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    background-color: var(--color-formulario);
    color: var(--color-texto-principal);
}

.name_user-input:focus,
.email_user-input:focus,
.password_user-input:focus {
    outline: none;
    border-color: var(--color-secundario);
}

/* ========== CONTENEDOR DEL CHECKBOX Y BOTÓN ========== */
.form__contenedor-button {
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* ========== CHECKBOX (RECUÉRDAME) ========== */
.remember_me {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: var(--color-principal);
}

.remember_me + label {
    font-size: 0.9rem;
    color: var(--color-texto-secundario);
    cursor: pointer;
}

/* ========== BOTÓN DE SUBMIT ========== */
.button {
    width: 100%;
    padding: 11px 20px;
    background-color: var(--color-principal);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
}

.button:hover {
    background-color: #15803d;
}

.button:active {
    opacity: 0.9;
}

/* ========== ENLACE DE REGISTRO ========== */
.form_register-user-contain {
    text-align: center;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-texto-secundario);
}

.form_register-user-contain a {
    color: var(--color-secundario);
    text-decoration: none;
    font-weight: 600;
}

.form_register-user-contain a:hover {
    text-decoration: underline;
}

/* ========== MEDIA QUERIES ========== */
@media (max-width: 768px) {
    .form {
        padding: 25px 20px;
        margin: 30px auto;
    }

    .name_user-label,
    .email_user-label,
    .password_user-label {
        font-size: 0.9rem;
    }

    .name_user-input,
    .email_user-input,
    .password_user-input {
        font-size: 0.9rem;
    }
}

@media (max-width: 480px) {
    .form {
        padding: 20px 15px;
        max-width: 100%;
        margin: 20px;
    }

    .button {
        padding: 10px 15px;
        font-size: 0.9rem;
    }
}
